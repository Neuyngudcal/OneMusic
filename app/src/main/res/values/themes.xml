<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ / Android 16 Core SplashScreen Theme for Zero-Delay Startup (luôn nền đen, logo thiết kế trên nền đen) -->
    <style name="Theme.OneMusic.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/obsidian_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OneMusic</item>
    </style>

    <!-- Main Application Theme (sáng). Bản tối: values-night/themes.xml. Compose đặt lại nền cửa sổ theo
         "Chế độ giao diện" của app khi chạy (xem OneMusicTheme). -->
    <style name="Theme.OneMusic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

</resources>
