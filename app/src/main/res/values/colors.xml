<?xml version="1.0" encoding="utf-8"?>
<!--
    OneMusic palette (bản XML cho widget, splash, drawable): Trắng – Xanh dương – Đen.
    Bản này là THEME SÁNG; bản tối ở values-night/colors.xml. Widget và màn hình khởi động chỉ theo
    chế độ sáng/tối của HỆ THỐNG (không theo cài đặt "Chế độ giao diện" trong app).
    Nguồn chuẩn cho Compose: java/com/example/onemusic/theme/AppColors.kt — sửa ở đó thì sửa cả ở đây.
-->
<resources>
    <!-- Luôn đen: nền màn hình khởi động và nền icon launcher (logo thiết kế trên nền đen) -->
    <color name="obsidian_black">#FF000000</color>

    <!-- Surfaces -->
    <color name="background">#FFFFFFFF</color>
    <color name="surface_base">#FFF8F8FA</color>
    <color name="surface_elevated">#FFF2F2F7</color>
    <color name="surface_card">#FFE5E5EA</color>
    <color name="surface_divider">#FFD1D1D6</color>

    <!-- Text -->
    <color name="text_primary">#FF000000</color>
    <color name="text_secondary">#FF3C3C43</color>
    <color name="text_tertiary">#FF737377</color>
    <!-- Viền mảnh: chữ chính 10% (tên cũ ivory_subtle giữ để khỏi sửa tham chiếu) -->
    <color name="ivory_subtle">#1A000000</color>

    <!-- Accents -->
    <color name="brand">#FF0066D6</color>
    <color name="apex_cyan">#FF00728F</color>
    <color name="apex_rose">#FFD70015</color>
</resources>
