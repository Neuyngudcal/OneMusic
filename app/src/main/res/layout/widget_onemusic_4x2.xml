<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_squircle"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Cover Art + Song Info -->
    <LinearLayout
        android:id="@+id/widget_top_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Squircle Cover Art -->
        <ImageView
            android:id="@+id/widget_cover_art"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="14dp"
            android:background="@color/surface_card"
            android:scaleType="centerCrop"
            android:src="@drawable/app_logo" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="OneMusic"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Samsung One UI 8.5 Experience"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_audio_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@color/surface_base"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Lossless Audio"
                android:textColor="@color/apex_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Favorite Heart -->
        <ImageButton
            android:id="@+id/widget_btn_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Yêu thích"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_heart" />
    </LinearLayout>

    <!-- Bottom Row: 5 Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Shuffle Button -->
        <ImageButton
            android:id="@+id/widget_btn_shuffle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Trộn bài"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_shuffle" />

        <!-- Previous Button -->
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bài trước"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_prev" />

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Phát/Tạm dừng"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <!-- Next Button -->
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bài tiếp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next" />

        <!-- Repeat Button -->
        <ImageButton
            android:id="@+id/widget_btn_repeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Lặp lại"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_repeat" />
    </LinearLayout>

</LinearLayout>
